  "description": "Sistema de gestión de citas – Instituto de Caridad Hermandad de Dolores (Ingeniería de Software, UDD)",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
