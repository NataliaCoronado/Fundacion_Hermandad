# Copia este archivo como .env y ajusta los valores. NUNCA subas el archivo .env al repositorio.
# El sistema lo lee solo con `npm start` (Node 20+).

# --- Base de datos (opcional) ---
# Sin DATABASE_URL se usan datos de muestra guardados en datos/estado.json.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/hermandad
# CLAVE_DEMO=demo1234        # solo desarrollo: contraseña de las cuentas de ejemplo

# --- Mensajes automáticos ---
MENSAJES_AUTOMATICOS=1       # 0 = apagado
BOT_WHATSAPP=0               # 1 = recordatorios del bot (semana antes, víspera, reintento)
WHATSAPP_MODO=simulado       # simulado = demostración, no sale ningún mensaje real | meta = WhatsApp Cloud API

# Solo con WHATSAPP_MODO=meta (valores que entrega Meta Business; son secretos):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_PLANTILLA=        # nombre de la plantilla aprobada, con 1 variable de cuerpo
# WHATSAPP_IDIOMA=es
# Webhook (respuestas de pacientes y estados de entrega). Sin estas dos variables no existe la ruta:
# WHATSAPP_APP_SECRET=        # secreto de la app en Meta: valida la firma de cada aviso
# WHATSAPP_VERIFY_TOKEN=      # texto que eliges tú y escribes igual en el panel de Meta
